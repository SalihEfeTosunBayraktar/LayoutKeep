# A source document must never sit in the repository root again: the arXiv paper that lived there
# was 10 MB, the largest tracked file in the repository, and its licence never allowed
# redistribution. Sources live under _artifacts/heldout/sources/, which is ignored as a whole.
/*.pdf
_artifacts/
*.spec.bak
layoutkeep_crash.log

# training local env and artifacts
training/.venv-train/
training/output_model/
training/merged_model/
training/gguf_model/
training/live_metrics.json

# The 100-page fixture and its translation: 6 MB of something `tools/make_academic_paper.py`
# rebuilds on demand. The 10-page pair is committed because the README and the comparison page
# are built from it; the measurements taken at 100 pages live in docs/samples/bench_*.json.
docs/samples/academic_paper.pdf
docs/samples/academic_paper.tr.pdf
test_out/

